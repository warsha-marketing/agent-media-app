# agent-media — environment template (self-host)
# Copy to .env and fill in. All config is injected at RUNTIME — never commit .env.
# Names below match what the code actually reads (verified against source).
#
# NOTE: never put a comment after `=` on the same line. Docker Compose's
# `env_file` reader does not strip them, so `FOO=bar   # note` sets FOO to the
# literal string "bar   # note". Comments live on their own line, above the var.

# ── Supabase (identity + data) — required ────────────────────────────────
SUPABASE_URL=
# server-side only; bypasses RLS — treat as root
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification + OAuth proxy; absent = OAuth off
SUPABASE_ANON_KEY=
# browser-safe copies read at runtime by the web app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Providers ─────────────────────────────────────────────────────────────
# comma-separated pool (video: Seedance 2.0 mini)
EVOLINK_API_KEYS=
EVOLINK_MAX_CONCURRENT_PER_KEY=3
# fal (queue API) — Reaction's person shots: Kling O3 Pro, Veo 3.1 fallback (#25).
# Read by primitive-worker-vnext. Empty = a Reaction render fails its person
# shots with PROVIDER_UNCONFIGURED (refunded); other Presets are unaffected.
FAL_KEY=
# gpt-image-2 + image moderation (absent = moderation off)
OPENAI_API_KEY=
# prompt craft (Haiku/Opus)
ANTHROPIC_API_KEY=

# Product Hero drafts (Brief + Product Details → Script with Targeted Diacritics → voice preview).
# The Voice is picked per draft from the Voice catalog (Approved Voices only);
# operators (ADMIN_EMAILS below) add and approve Voices via /v1/operator/voices
# or /dashboard/admin/voices. Empty key = drafting answers 503
ELEVENLABS_API_KEY=
# Optional pins (defaults: claude-opus-5-5, eleven_v3) and per-user hourly ceiling (default 30)
PRODUCT_HERO_SCRIPT_MODEL=
PRODUCT_HERO_TTS_MODEL=
DRAFTS_PER_HOUR=

# ── Object storage (S3-compatible) — required by workers ─────────────────
# Defaults target Cloudflare R2. Set S3_ENDPOINT to point anywhere else
# (MinIO, AWS S3, Backblaze B2) — docker-compose.yml does exactly that.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# NOTE: code reads R2_BUCKET (not R2_BUCKET_NAME)
R2_BUCKET=agent-media-outputs
R2_PUBLIC_URL=
# REQUIRED for Product Hero: a bucket with public access OFF for private
# objects (draft voice audio, served only via short-lived signed URLs). Set the
# SAME value on api-v2 and primitive-worker-vnext. There is no fallback to
# R2_BUCKET: empty = drafting answers 503 DRAFT_STORAGE_UNCONFIGURED and the
# worker fails renders with DRAFT_STORAGE_UNCONFIGURED (non-retryable).
R2_PRIVATE_BUCKET=
# Empty = derive https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# MinIO example: S3_ENDPOINT=http://minio:9000 with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
# Empty = "auto" (correct for R2). AWS S3 needs a real region, e.g. us-east-1
S3_REGION=
# "true" for MinIO and most non-AWS gateways; empty = virtual-hosted style
S3_FORCE_PATH_STYLE=
# Host that presigned URLs (browser photo uploads, draft audio) are signed for,
# when api-v2 reaches storage by a name browsers cannot (compose: minio:9000 vs
# http://localhost:9000). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# The web dashboard PUTs product photos directly to the bucket, so the bucket
# must allow the dashboard origin (CORS). docker-compose sets it on MinIO from
# this (comma-separated; empty = http://localhost:WEB_PORT). On R2 add a bucket
# CORS rule instead: see README, "Storage CORS".
STORAGE_CORS_ORIGINS=

# ── Temporal (vNext orchestration) — required for composed workflows ─────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true

# ── Billing mode ─────────────────────────────────────────────────────────
# FAIL-CLOSED: billing is ON unless you explicitly set BILLING_MODE=disabled.
# Self-hosters set `disabled` to skip the credit ledger entirely and pay their
# upstream providers directly.
#
# ⚠ Set this IDENTICALLY on api-v2 AND every worker. A split configuration is
# how media gets rendered without being charged.
BILLING_MODE=

# Stripe — only needed when BILLING_MODE is not 'disabled'.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Internal service auth (generate long random strings) ─────────────────
WORKER_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=
SUBTITLE_WORKER_SECRET=
VNEXT_PRIMITIVE_WORKER_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────
# off = the vNext skills surface is dark
VNEXT_PRIMITIVES_ENABLED=true
# curates the agent surface to make_ugc (+ podcast/subtitles)
MAKE_UGC_ENABLED=true
# set 1 to fail closed on moderation outages
IMAGE_MODERATION_FAILCLOSED=

# ── URLs ──────────────────────────────────────────────────────────────────
PUBLIC_API_ORIGIN=http://localhost:3001
PORT=3001

# ── Web app (read at RUNTIME by the root layout, not baked at build) ─────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# Server-side: the api-v2 every web proxy calls (drafts, voices, uploads,
# skills quote/run/status). Unset = https://api.agent-media.ai; docker-compose
# sets http://api-v2:3001. AGENT_API_V2_URL is a deprecated override read only
# by the agent brain and its chat persistence (/api/agent, /api/v1/agent/*).
# API_V2_URL=http://localhost:3001

# ── Provider selection (see services/media-worker-v2/src/providers/) ─────
# Registered adapters: evolink (default), byteplus
VIDEO_PROVIDER=evolink
# Optional model pins
EVOLINK_SEEDANCE_MODEL=
BYTEPLUS_SEEDANCE_MODEL=
GPT_IMAGE_MODEL=
# Required only when VIDEO_PROVIDER=byteplus
ARK_API_KEY=

# ── Access control & support (fail-closed defaults) ──────────────────────
# Comma-separated admin emails. EMPTY by default: a fresh install grants
# admin to nobody until you opt someone in. api-v2 also reads it: these are
# the operators who approve and revoke Voices.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
# Support form: empty disables it.
SUPPORT_INBOX=
SUPPORT_FROM=
RESEND_API_KEY=

# ── Optional browser-facing config ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Host port for the dashboard (container always listens on 3000).
WEB_PORT=3000
